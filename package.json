{
  "name": "octamod",
  "license": "GPL-3.0-or-later",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/check.mjs --build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "test": "vitest run",
    "check": "node scripts/check.mjs",
    "deploy": "npm run build && wrangler deploy --config wrangler.worker.jsonc",
    "dev:community": "wrangler dev --config wrangler.worker.jsonc --port 8788",
    "db:local": "wrangler d1 migrations apply octamod-community --config wrangler.worker.jsonc --local",
    "admin:key": "node scripts/admin-key.mjs",
    "domain:check": "node scripts/domain-check.mjs",
    "deploy:pages": "npm run build && wrangler pages deploy",
    "machines:generate": "node scripts/machines.mjs --write",
    "machines:check": "node scripts/machines.mjs",
    "elekloader:check": "node scripts/elekloader-vendor.ts",
    "elekloader:update": "node scripts/elekloader-update.ts",
    "modules:generate": "node scripts/modules.mjs --write",
    "modules:check": "node scripts/modules.mjs",
    "licenses:generate": "node scripts/licenses.mjs --write",
    "licenses:check": "node scripts/licenses.mjs && node --test scripts/license-notices.node-test.mjs",
    "module:new": "node scripts/scaffold-module.mjs",
    "module:verify": "node scripts/module-verify.mjs",
    "module:doctor": "node scripts/module-doctor.mjs",
    "sdk:check": "node scripts/sdk-check.mjs",
    "modules:build": "python3 -B scripts/build-module-packages.py",
    "modules:build:elemod": "node scripts/build-elemod-packages.mjs",
    "modules:import": "node scripts/import-module-build.mjs",
    "typecheck": "tsc -b",
    "build:bundle": "vite build",
    "push:keys": "node scripts/push-keys.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "better-auth": "1.7.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "globals": "17.12.0",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3",
    "wrangler": "4.144.0"
  },
  "overrides": {
    "source-map-js": "1.2.1"
  }
}
