{
  "name": "octamod-community",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "alias": { "@better-auth/core/async_hooks": "./server/auth-async-hooks.ts" },
  "triggers": { "crons": ["* * * * *", "17 * * * *", "*/5 * * * *"] },
  // Workers Logs: searchable request logs and exceptions in the Cloudflare dashboard, kept for a few days.
  "observability": { "enabled": true },
  // Production values. Local development overrides vars through the ignored .dev.vars file.
  "vars": {
    // Production push is enabled after VAPID setup; devices still opt in independently.
    "WEB_PUSH_ENABLED": "true",
    // Immutable GitHub identities allowed to notify after the reviewed Pages deployment.
    "RELEASE_REPOSITORY_ID": "1399349338",
    "RELEASE_REPOSITORY_OWNER_ID": "67785539",
    "APP_URL": "https://modwerk.app/",
    "AUTH_BASE_URL": "https://octamod-community.octamod.workers.dev/api/auth",
    "REGISTRATION_OPEN": "false",
    "PRIVACY_READY": "false",
    "SESSION_TRANSPORT": "bearer",
    "WELCOME_MAIL_ENABLED": "true",
    // Paid Resend plan: 50,000/month. Independent 30-day budgets total 48,000 attempts.
    // Verification/recovery capacity cannot be consumed by welcomes, activity or news.
    "ACCOUNT_MAIL_DAILY_LIMIT": "500",
    "ACCOUNT_MAIL_MONTHLY_LIMIT": "6000",
    "WELCOME_MAIL_DAILY_LIMIT": "500",
    "WELCOME_MAIL_MONTHLY_LIMIT": "6000",
    "ACTIVITY_MAIL_DAILY_LIMIT": "1000",
    "ACTIVITY_MAIL_MONTHLY_LIMIT": "24000",
    "NEWS_MAIL_DAILY_LIMIT": "500",
    "NEWS_MAIL_MONTHLY_LIMIT": "12000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "octamod-community",
      "database_id": "ef3ad4a1-5554-45a6-a841-6314367e3cec",
      "migrations_dir": "migrations"
    }
  ],
  // Images and sound clips attached to forum posts. Module screenshots and audio arrive through PRs and are
  // served by the site instead. Create the bucket once with `npx wrangler r2 bucket create modwerk-forum-media`.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "modwerk-forum-media"
    }
  ],
  "main": "worker.ts"
}
