{
 "elemod": 2,
 "id": "midi-loopback",
 "version": "1.6",
 "title": "MIDI Loopback",
 "description": "Internal MIDI loopback: sequences and modulates audio tracks 1-8 and Master FX from MIDI tracks 9-16 using parameter locks, CCs, note triggers, and LFOs without external cables. Toggle ON/OFF in SETTINGS > MIDI LOOPBACK. Displays Digitakt parameter names on MIDI tracks' FLTR CC Select page.",
 "category": "MIDI",
 "author": "",
