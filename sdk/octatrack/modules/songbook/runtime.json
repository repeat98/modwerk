    {"event": "ev_project_new", "fn": "as_project_new", "order": 50},
    {"event": "ev_project_stored", "fn": "as_project_stored", "order": 50},
    {"event": "ev_project_reloaded", "fn": "as_project_reloaded", "order": 50},
    {"event": "ev_modules_ready", "fn": "as_modules_ready", "order": 50}
  ]
}
