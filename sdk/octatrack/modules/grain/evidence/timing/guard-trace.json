 "instrumentation": "diff --git a/sdk/machines/octatrack/elekloader/machine_registry.c b/sdk/machines/octatrack/elekloader/machine_registry.c\nindex 16d1dfd65..8b66b7cfb 100644\n--- a/sdk/machines/octatrack/elekloader/machine_registry.c\n+++ b/sdk/machines/octatrack/elekloader/machine_registry.c\n@@ -905,6 +905,9 @@ static uint32_t late, cost[16], after[16], end_at[16], timed; /* [track], then a\n static uint16_t skipped[16];\n static uint32_t before;            /* the renders the last frame made (bit k), skipped or not */\n static uint8_t place[16], next[16], made; /* a render's place in the last frame's order, and in this frame's so far */\n+/* shortcut: diagnostic twin only (Grain #1858), never committed: the guard's inputs at each skip and every overrun frame */\n+volatile uint32_t mw_shed_trace[256][9], mw_shed_trace_n, mw_over_trace[128][20], mw_over_trace_n;\n+static uint32_t shed_first, shed_open, spent[16];\n void mw_frame_exit(void)\n {\n     uint32_t now = DTCN3, d = now - mw_frame_t0, due = d + late;\n@@ -915,6 +918,13 @@ void mw_frame_exit(void)\n     int32_t c = credit + (int32_t)mw_frame_share - (int32_t)d;\n     credit = c > (int32_t)BURST ? (int32_t)BURST : c < -(int32_t)FRAME ? -(int32_t)FRAME : c;\n     mw_frame_busy += d >> 8, mw_frame_count = mw_frame_count + 1u;\n+    if (shed_open) { for (uint32_t i = shed_first; i != mw_shed_trace_n; ++i) mw_shed_trace[i & 255u][8] = d; shed_open = 0; }\n+    if (d > FRAME) {\n+        volatile uint32_t *o = mw_over_trace[mw_over_trace_n & 127u];\n+        o[0] = mw_frame_count, o[1] = d, o[2] = late, o[3] = timed;\n+        for (unsigned j = 0; j < 16u; ++j) o[4 + j] = timed >> j & 1u ? spent[j] : 0;\n+        mw_over_trace_n = mw_over_trace_n + 1u;\n+    }\n     if (timed) for (unsigned k = 0; k < 16u; ++k) if (timed >> k & 1u) after[k] = now - end_at[k], place[k] = next[k];\n     before = timed, timed = 0, made = 0;\n     frame_seen = 0;\n@@ -936,12 +946,19 @@ static int guarded(Render *f, Render *instead, unsigned track, unsigned ping, un\n     int32_t over = (int32_t)(at - mw_frame_t0 + cost[k] + after[k]) - credit - (int32_t)mw_frame_share;\n     if (over > 0 && !dearer_later(k, (uint32_t)over) && ++skipped[k] < PROBE) {\n         mw_frame_sheds = mw_frame_sheds + 1u, mw_frame_shed_tracks |= 1u << track;\n+        if (!shed_open) shed_first = mw_shed_trace_n, shed_open = 1;\n+        volatile uint32_t *z = mw_shed_trace[mw_shed_trace_n & 255u];\n+        z[0] = mw_frame_count, z[1] = k << 16 | timed, z[2] = before, z[3] = at - mw_frame_t0, z[4] = cost[k], z[5] = after[k];\n+        z[6] = (uint32_t)credit, z[7] = mw_frame_last, z[8] = 0;\n+        mw_shed_trace_n = mw_shed_trace_n + 1u;\n         r = instead(track, ping, start, end);\n+        spent[k] = DTCN3 - at;\n     } else {\n         unsigned back = skipped[k] != 0;\n         skipped[k] = 0;\n         r = f(track, ping, start, end);\n         uint32_t c = DTCN3 - at, fall = cost[k] - (cost[k] >> 3);\n+        spent[k] = c;\n         cost[k] = back || c > fall ? c : fall; /* a rise at once, a fall by an eighth a frame; after skips, as measured */\n         if (c > mw_frame_cost_max[k]) mw_frame_cost_max[k] = c;\n     }\n",
