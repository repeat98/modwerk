{
 "elemod": 2,
 "id": "silent-pad-trig",
 "version": "0.6.0-experimental",
 "title": "Silent Pad+Trig Settings",
 "description": "Three checkboxes: pads and TRIG keys select silently outside recording; pads stay silent in LIVE RECORDING; MUTE ALL SOUND keeps a muted track silent from pads, TRIG keys and MIDI, while trigs still record.",
