{
 "elemod": 2,
 "id": "improved-performance",
 "version": "0.2.0-experimental",
 "title": "Improved Performance",
 "description": "Skips audio work that cannot change the sound, so patterns use less CPU and keys and pads answer faster. CPU or OVR warns you near the limit; under overload the screen redraws at half rate so presses get through.",
 "category": "system",
 "author": "npp1993",
 "license": "GPL-3.0-or-later",
