 "resources": {
  "regions": [],
  "names": [
   "ui:FIX + knob on the sound pages",
   "ui:CHRO + knob on the sound pages",
   "ui:CHRO tap toggles chromatic mode on the release",
   "ui:FIX tap toggles fixed velocity on the release",
   "ui:LFO + knob on the sound pages and the FX track",
   "ui:LFO page key shows its page on the release",
   "ui:SCENE + knob on the sound pages and the FX track",
   "ui:SCENE hold opens scene edit on the release",
   "ui:SCENE + pad in scene mode selects the track",
   "ui:SCENE + REC, STOP, PLAY, YES copy, paste, clear, apply the scene",
   "ui:SCENE + knob in scene edit locks its scene",
   "ui:QPER + pads and trigs",
   "ui:RECORD + YES",
   "ui:RECORD + NO",
   "ui:live recording of performance moves",
   "ui:PERF + knob on the sound pages and the FX track",
   "ui:PERF hold opens performance edit on the release",
   "ui:PERF + YES, PLAY, RECORD, STOP act on the linked performance",
   "ui:FIX + PLAY clears the sound's velocity links",
   "ui:CHRO + PLAY clears the sound's aftertouch links",
   "ui:LFO + REC, STOP, PLAY copy, paste, clear the LFO page"
  ],
  "core": "0.7"
 },
