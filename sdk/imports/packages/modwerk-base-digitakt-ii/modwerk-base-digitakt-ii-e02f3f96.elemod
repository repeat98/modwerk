{
 "elemod": 2,
 "id": "core",
 "version": "1.1",
 "title": "core",
 "description": "Modwerk's core for the Digitakt II: the boot copier and the hook bus every other mod needs (tick, draw, key, encoder, SETTINGS and PERSONALIZE rows), each frame's per-track parameter values before the stock modulators (ev_frame_params), the key-LED frame before the stock views (ev_key_leds), the mods' project data and kit data, saved and loaded with the project and its kits and carried through kit copies (core_projdata, core_kitdata), and value rows (core_addvalue). On its own it changes nothing the unit does.",
 "category": "Framework",
 "author": "Modwerk",
 "license": "GPL-2.0-or-later",
 "target": {
  "device": "digitakt-mk2",
  "product": "Digitakt II",
  "os": "1.17",
  "syx_sha256": "26c22f6652625ac2cfd47f7ee970d388ed8b6427dae3563c0a6a2f2d334350d5",
