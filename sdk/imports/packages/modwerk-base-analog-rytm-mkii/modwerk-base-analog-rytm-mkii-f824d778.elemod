{
 "elemod": 2,
 "id": "core",
 "version": "0.7",
 "title": "core",
 "description": "The boot copier, the hook bus, mod storage and parameter pages for the Analog Rytm MKII: every other mod needs it. The Digitakt mk1's core.s, settings.s and render.s with the Rytm's addresses, and store.c: fields mods declare, placed by elekloader from the build's lockfile and kept in bytes stock never uses or always holds at 0; and pages.s: parameter pages and parameter overrides mods add through the tables core_pages and core_params (and core_page_fns, a page whose knobs follow the sound), from the first instructions of the four routines a page goes through, and the page keys' lists, stock's pages and then the ones mods add through core_view_pages, which the page key steps through (skipping a page while its mod says it is hidden, with the page's title in the header), and which keeps its page when the view is shown again; load.s: the audio interrupt's load, core_audio_load, for mods with work they can skip; and machines.c: machines mods add in the hidden slots 34..43 through core_machines, written into the machine table and the slots' parameter records at boot. On its own it changes nothing the unit does. And finish.s: an OS upgrade's restart sends the panel link's and the UART's queued bytes before it masks interrupts, where stock can hang on SUCCESS! REBOOTING.",
 "category": "Framework",
 "author": "irpina, Iced-Cream",
 "license": "GPL-2.0-or-later",
 "target": {
  "device": "analog-rytm-mk2",
  "product": "Analog Rytm MKII",
  "os": "1.74",
  "syx_sha256": "cb0f99d620edde994fb860c0e79cc2464e427d06882828cfdfb00fc53700e123",
  "section3_sha256": "34cd0c4da8e4b810d1b25284475a99ea53821e2ab7d30a978bf15dc578251f3b",
  "section3_len": 3005432
 },
