{
 "elemod": 2,
 "id": "machine-pages",
 "version": "1.2.1",
 "title": "machine pages",
 "description": "Draws the SRC and LFO pages of the SRC machines that describe their own, gives the render an event for machines that make or take a track's sound, and from 1.2 lets a machine have up to seven more SRC values on a second page, so several machine mods combine. irpina's Machine Pages 1.2, ported to run on Core 2.1. On its own, and for machines that do not describe a page, it changes nothing the unit does.",
 "category": "system",
 "author": "irpina",
 "license": "GPL-2.0-or-later",
 "target": {
  "device": "digitakt-mk1",
  "product": "Digitakt mk1",
