  "hooks": {
    "added2_13": [
      "0x40055382 qz_mknob (jsr, 8 B): the knob handler's MIDI-track clamp just before its store 0x4005538a (which stays stock) -- a MIDI track's NOTE knob steps by scale degree from ROOT",
      "0x40050b98 qz_mplock (jsr, 10 B): the MIDI p-lock editor's lock store -- a NOTE lock steps by scale degree from ROOT",
      "0x400436a8 qz_mkey (jmp, 10 B): the MIDI CHROMATIC key press -- the key's note + ROOT snapped to the nearest scale note (ties down); the note-on, the arpeggiator's add, the held note (so the note-off) and the live recorder take it"
    ],
    "unchangedSite": [
      "0x400449be qz_octnum (jmp, 8 B): the CHROMATIC drawer's common argument push -- Modwerk 0.1.2's #264 site, now the author's own form (2.13); a MIDI track keeps stock's number, with ROOT's name before it when a scale is on"
    ],
    "engine": "The FM engine (poly.s), the chooser (machine.s), the page (page.s), engine_abi.inc and upstream/synth/manifest.py are unchanged from 0.1.4 (same bytes); their hooks are synth-ca13ed8.json's."
  },
