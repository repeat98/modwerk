{
 "id": "core",
 "version": "0.7",
 "license": "GPL-2.0-or-later",
 "title": "core",
 "category": "Framework",
 "author": "Jannik Aßfalg",
 "description": "Modwerk's core for the Analog Rytm MKII, which every other mod needs. It boots the base and runs the hook bus (ev_tick, ev_draw, ev_key, ev_enc, ev_settings, ev_render_in, ev_render_out); keeps the fields mods declare with the unit's own sounds, kits, global slots, patterns and project, in bytes stock leaves unused, and tells mods when a project is created or loaded (ev_project); asks the pages, parameters and page-key lists mods add (core_pages, core_page_fns, core_params, core_view_pages) before stock's own, with hidden pages skipped and the page's title in the header; writes the machines mods add in slots 34..43 (core_machines) into the machine tables at boot; measures the audio interrupt's load (core_audio_load); and lets an OS upgrade's restart send its queued bytes before it masks interrupts. On its own it changes nothing the unit does.",
 "device": "analog-rytm-mk2",
 "os": "1.74",
