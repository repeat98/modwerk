# Improved AMP: ENV RESET's fade comes before swung trigs too. The BD track holds a trig on each of steps
# 1 to 15 and HLD 57 holds each hit into the next. ENV RESET AMP, 120 BPM: at 50 % swing the dips are 125 ms
# apart, at 66 % they come 165 and 85 ms apart in turn (a swung step sits 66 % into its pair of steps),
# one before every trig but the first. STOP comes after step 15; step 16 is empty, so the next trig is
# 140 ms or more after STOP is sent.
# PATTERN SWING opens with FUNC + BANK G (SWING); DOWN to its lowest is 50 %.
# The BD track needs a sound that rings with the AMP envelope open.
# Changes the tempo, the BD track's AMP page and its ENV RESET in the active kit, the active pattern's
# swing, and its BD track, which it clears; ends at 120 BPM, ENV RESET OFF, HLD 0, swing 50 %, the track
# empty.
name: improved-amp-prefade-swing
state: changes
transport: any
target: unit

hold TRK
key BD
release TRK
# Tempo to 120.0: down to the bottom (30.0), then 90 BPM up, a step of the tempo screen's LEVEL being 1 BPM.
key TEMPO
enc LEVEL -127 x64
nudge LEVEL +21 per 6 x4
nudge LEVEL +6 per 6
wait 500
screen tempo
expect tempo == ref region 40 15 88 33
key NO
key AMP
cc 78 0
cc 79 57
cc 80 55
cc 81 0
cc 82 0
cc 83 0
cc 10 64
cc 7 100
hold FUNC
wait 300
key MUTE
release FUNC
key UP x4
key DOWN x4
key YES
key UP x8
key DOWN x2
key LEFT x3
key RIGHT
wait 500
screen er1
expect er1 == ref region 39 26 82 11
key NO x3
key RECORD
wait 300
key T1
key FUNC+PLAY
wait 800
key T1
key T2
key T3
key T4
key T5
key T6
key T7
key T8
key T9
key T10
key T11
key T12
key T13
key T14
key T15
wait 300
key RECORD
wait 300
key FUNC+BANK_G
wait 400
key DOWN x40
wait 300
screen swing50
expect swing50 == ref
key NO
wait 300
audio sw50 BD 2800
wait 100
key PLAY
wait 1740
key STOP
wait 900
key FUNC+BANK_G
wait 400
key UP x16
wait 300
screen swing66
expect swing66 == ref
expect swing66 != swing50
key NO
wait 300
audio sw66 BD 2800
wait 100
key PLAY
wait 1740
key STOP
wait 900
key FUNC+BANK_G
wait 400
key DOWN x40
wait 300
screen swingback
expect swingback == swing50
key NO
hold FUNC
wait 300
key MUTE
release FUNC
key UP x4
key DOWN x4
key YES
key UP x8
key DOWN x2
key LEFT x3
wait 500
screen er0
expect er0 == ref region 39 26 82 11
key NO x3
key RECORD
wait 300
key T1
key FUNC+PLAY
wait 800
key RECORD
cc 79 0

expect sw50.dips == 14
expect sw50.gapmin == 125 within 3
expect sw50.gapmax == 125 within 3
expect sw66.dips == 14
expect sw66.gapmin == 85 within 4
expect sw66.gapmax == 165 within 4
