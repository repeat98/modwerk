# Improved AMP (0.1.0-experimental): FUNC + turn on AMP HLD stops at 0, 0.125, 0.25, 0.5, 0.75, 1, 1.5, 2,
# 3, 4, 8, 16, 32 and 64 steps and AUTO, both ways: from HLD 7 one turn up reads 0.125 and the next 0.25,
# and back down 0.125 and 0; from 0 each of fourteen turns up is looked at (0.125 .. 64, AUTO), a fifteenth
# stays, and three turns down read 64, 32 and 16 again.
# Screens only: what the envelopes, the overdrive and the pre-fade sound like is in the sound cases.
# The case sets what its references show: the BD track, every value of the page by CC on the auto channel
# and, where a number depends on it, the tempo. The title bar (kit name, tempo, record state) and the status
# line (track level, pattern) are left out of every comparison (`ignore`).
# A value shows as text in place of its label for a while after a knob turn (not after a CC), so every
# screen is taken after a turn of the knob it is about. The AMP and FILTER pages take 3 counts a step.
# Changes the tempo (to 120.0) and the BD track's sound in the active kit and does not put them back.
name: improved-amp-hld-func
state: changes
ignore: 0 0 128 9, 0 55 128 9

hold TRK
key BD
release TRK
key AMP
key TEMPO
enc LEVEL -127 x64
nudge LEVEL +21 per 6 x4
nudge LEVEL +6 per 6
wait 500
screen tempo
expect tempo == ref region 40 15 88 33
key NO
cc 78 0
cc 79 0
cc 80 55
cc 81 0
cc 82 0
cc 83 0
cc 10 64
cc 7 100
cc 79 1
nudge B -1 per 3
wait 750
screen h0
nudge B +7 per 3
wait 750
screen h7
expect h7 == ref
hold FUNC
nudge B +1 per 3
wait 750
screen up1
expect up1 == ref
nudge B +1 per 3
wait 750
screen up2
expect up2 == ref
nudge B -1 per 3
wait 750
screen down1
expect down1 == up1
nudge B -1 per 3
wait 750
screen down2
expect down2 == h0
nudge B +1 per 3
wait 750
screen g0125
expect g0125 == ref
nudge B +1 per 3
wait 750
screen g025
expect g025 == ref
nudge B +1 per 3
wait 750
screen g05
expect g05 == ref
nudge B +1 per 3
wait 750
screen g075
expect g075 == ref
nudge B +1 per 3
wait 750
screen g1
expect g1 == ref
nudge B +1 per 3
wait 750
screen g1_5
expect g1_5 == ref
nudge B +1 per 3
wait 750
screen g2
expect g2 == ref
nudge B +1 per 3
wait 750
screen g3
expect g3 == ref
nudge B +1 per 3
wait 750
screen g4
expect g4 == ref
nudge B +1 per 3
wait 750
screen g8
expect g8 == ref
nudge B +1 per 3
wait 750
screen g16
expect g16 == ref
nudge B +1 per 3
wait 750
screen g32
expect g32 == ref
nudge B +1 per 3
wait 750
screen g64
expect g64 == ref
nudge B +1 per 3
wait 750
screen gauto
expect gauto == ref
nudge B +1 per 3
wait 750
screen over
expect over == gauto
nudge B -1 per 3
wait 750
screen d64
expect d64 == g64
nudge B -1 per 3
wait 750
screen d32
expect d32 == g32
nudge B -1 per 3
wait 750
screen d16
expect d16 == g16
expect g0125 == up1
expect g025 == up2
release FUNC
