# Improved AMP: ENV RESET's fade before retrigs at a fast tempo. 200 BPM (a step is 75 ms); the BD track
# holds one trig with a retrig lock on step 1 (the kit's RATE and LEN: 1/16 and 1/4 here, four strikes
# 75 ms apart) and HLD 57 holds each strike into the next. Each take plays the pattern three times (from
# 0, 1200 and 2400 ms; STOP about 250 ms after the last strike).
# ENV RESET AMP: 3 hits, 9 dips, the shortest 75 ms apart. OFF: 3 hits, no dip.
# Not shown: the module's note that above 187.5 BPM a retrig tick moved a block by a queued event can
# move the next one too. No event fires within the series here, and a block (0.67 ms) is under what
# the dips' times resolve.
# Expected from the module's README and code and from stock's manual; not yet run on the unit.
# The retrig menu's screen is checked against its reference. The BD track needs a sound that rings with
# the AMP envelope open.
# Changes the tempo, the BD track's AMP page and its ENV RESET in the active kit, and the BD track of the
# active pattern, which it clears; ends at 120 BPM, ENV RESET OFF, HLD 0, the track empty.
name: improved-amp-prefade-fast
state: changes
transport: any
target: unit

hold TRK
key BD
release TRK
# Tempo to 200.0: down to the bottom (30.0), then 170 BPM up.
key TEMPO
enc LEVEL -127 x64
nudge LEVEL +21 per 6 x8
nudge LEVEL +2 per 6
wait 500
screen tempo200
expect tempo200 == ref region 40 15 88 33
key NO
key AMP
cc 78 0
cc 79 57
cc 80 55
cc 81 0
cc 82 0
cc 83 0
cc 10 64
cc 7 100
hold FUNC
wait 300
key MUTE
release FUNC
key UP x4
key DOWN x4
key YES
key UP x8
key DOWN x2
key LEFT x3
key RIGHT
wait 500
screen er1
expect er1 == ref region 39 26 82 11
key NO x3
key RECORD
wait 300
key T1
key FUNC+PLAY
wait 800
key T1
hold T1
wait 300
key RTRG
wait 400
key RTRG
wait 400
screen rt1
release T1
wait 300
expect rt1 == ref region 13 19 104 28
key RECORD
wait 300
audio famp BD 3700
wait 100
key PLAY
wait 2780
key STOP
wait 900
hold FUNC
wait 300
key MUTE
release FUNC
key UP x4
key DOWN x4
key YES
key UP x8
key DOWN x2
key LEFT x3
wait 500
screen er0
expect er0 == ref region 39 26 82 11
key NO x3
wait 300
audio foff BD 3700
wait 100
key PLAY
wait 2780
key STOP
wait 900
key RECORD
wait 300
key T1
key FUNC+PLAY
wait 800
key RECORD
cc 79 0
# Tempo to 120.0: down to the bottom (30.0), then 90 BPM up, a step of the tempo screen's LEVEL being 1 BPM.
key TEMPO
enc LEVEL -127 x64
nudge LEVEL +21 per 6 x4
nudge LEVEL +6 per 6
wait 500
screen tempo
expect tempo == ref region 40 15 88 33
key NO

expect famp.hits == 3
expect famp.dips == 9
expect famp.gapmin == 75 within 3
expect foff.hits == 3
expect foff.dips == 0
