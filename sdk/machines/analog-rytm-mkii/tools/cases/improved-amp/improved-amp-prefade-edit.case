# Improved AMP: an ENV RESET edit acts on the trigs that follow, while the pattern plays. The BD track
# holds a trig on every second step (250 ms apart at 120 BPM) and HLD 57 holds each hit into the next.
# SOUND SETTINGS stays open on ENV RESET: PLAY at OFF (`before`: no dip), RIGHT to AMP (`after`, 2 s
# from 0.5 s after the edit's screen: 8 trigs fall in it, so more than 6 dips, the window's ends cutting
# one at most), LEFT to OFF (`back`: no dip). One hit each: the sound never ends.
# Expected from the module's README and code and from stock's manual; not yet run on the unit.
# The BD track needs a sound that rings with the AMP envelope open.
# Changes the tempo, the BD track's AMP page and its ENV RESET in the active kit, and the BD track of the
# active pattern, which it clears; ends at 120 BPM, ENV RESET OFF, HLD 0, the track empty.
name: improved-amp-prefade-edit
state: changes
transport: any
target: unit

hold TRK
key BD
release TRK
# Tempo to 120.0: down to the bottom (30.0), then 90 BPM up, a step of the tempo screen's LEVEL being 1 BPM.
key TEMPO
enc LEVEL -127 x64
nudge LEVEL +21 per 6 x4
nudge LEVEL +6 per 6
wait 500
screen tempo
expect tempo == ref region 40 15 88 33
key NO
key AMP
cc 78 0
cc 79 57
cc 80 55
cc 81 0
cc 82 0
cc 83 0
cc 10 64
cc 7 100
key RECORD
wait 300
key T1
key FUNC+PLAY
wait 800
key T1
key T3
key T5
key T7
key T9
key T11
key T13
key T15
wait 300
key RECORD
hold FUNC
wait 300
key MUTE
release FUNC
key UP x4
key DOWN x4
key YES
key UP x8
key DOWN x2
key LEFT x3
wait 500
screen er0
expect er0 == ref region 39 26 82 11
wait 300
audio before BD 2000
wait 100
key PLAY
wait 2200
key RIGHT
wait 500
screen er1
expect er1 == ref region 39 26 82 11
wait 500
audio after BD 2000
wait 2100
key LEFT x3
wait 500
screen er0b
expect er0b == er0 region 39 26 82 11
wait 500
audio back BD 2000
wait 2100
key STOP
wait 900
key NO x3
key RECORD
wait 300
key T1
key FUNC+PLAY
wait 800
key RECORD
cc 79 0

expect before.hits == 1
expect before.dips == 0
expect after.hits == 1
expect after.dips > 6
expect back.hits == 1
expect back.dips == 0
