# Improved AMP: ENV RESET's fade before a retrig is heard. The BD track holds two trigs with a retrig lock
# (steps 1 and 9, the kit's retrig RATE and LEN: 1/16 and 1/4 here, four strikes a trig) and HLD 57 holds
# each strike into the next. With ENV RESET at AMP the voice fades out before every retrig; at OFF it does
# not.
# Measured on the unit, from RAM, 10 Nov 2026: 5 trigs play before STOP; hits 5 and dips 15 at AMP,
# hits 5 and dips 0 at OFF. The retrig menu's screen is checked against its reference, so another
# kit's RATE or LEN fails the case there. The BD track needs a sound that rings with the AMP envelope open.
# Changes the tempo, the BD track's AMP page and its ENV RESET in the active kit, and the BD track of the
# active pattern, which it clears; ends at 120 BPM, ENV RESET OFF, HLD 0, the track empty.
name: improved-amp-prefade-retrig
state: changes
transport: any
target: unit

hold TRK
key BD
release TRK
# Tempo to 120.0: down to the bottom (30.0), then 90 BPM up, a step of the tempo screen's LEVEL being 1 BPM.
key TEMPO
enc LEVEL -127 x64
nudge LEVEL +21 per 6 x4
nudge LEVEL +6 per 6
wait 500
screen tempo
expect tempo == ref region 40 15 88 33
key NO
key AMP
cc 78 0
cc 79 57
cc 80 55
cc 81 0
cc 82 0
cc 83 0
cc 10 64
cc 7 100
hold FUNC
wait 300
key MUTE
release FUNC
key UP x4
key DOWN x4
key YES
key UP x8
key DOWN x2
key LEFT x3
key RIGHT
wait 500
screen er1
expect er1 == ref region 39 26 82 11
key NO x3
key RECORD
wait 300
key T1
key FUNC+PLAY
wait 800
key T1
key T9
hold T1
wait 300
key RTRG
wait 400
key RTRG
wait 400
screen rt1
release T1
wait 300
hold T9
wait 300
key RTRG
wait 400
key RTRG
wait 400
screen rt9
release T9
wait 300
expect rt1 == ref region 13 19 104 28
expect rt9 == rt1 region 13 19 104 28
key RECORD
wait 300
audio rtamp BD 5000
wait 100
key PLAY
wait 4480
key STOP
wait 700
hold FUNC
wait 300
key MUTE
release FUNC
key UP x4
key DOWN x4
key YES
key UP x8
key DOWN x2
key LEFT x3
wait 500
screen er0
expect er0 == ref region 39 26 82 11
key NO x3
wait 300
audio rtoff BD 5000
wait 100
key PLAY
wait 4480
key STOP
wait 700
key RECORD
wait 300
key T1
key FUNC+PLAY
wait 800
key RECORD
cc 79 0

expect rtamp.hits == 5
expect rtamp.dips == 15
expect rtoff.hits == 5
expect rtoff.dips == 0
