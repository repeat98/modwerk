# Improved AMP: ENV RESET's fade comes before micro-timed trigs too. The BD track holds trigs on steps 1,
# 3, 5 and 7 (250 ms apart at 120 BPM), step 3 moved late by 5/384 and step 5 early by 5/384 of a bar
# (26 ms; in GRID RECORDING hold the trig, RIGHT or LEFT: the first press opens MICRO TIMING, each
# further one moves by 1/384). HLD 57 holds each hit into the next and ENV RESET is at AMP.
# The trigs strike at 0, 276, 474 and 750 ms: 3 dips, 198 and 276 ms apart. `mt` plays the pattern once,
# `mt3` three times (STOP after the third time's step 7: 3 hits, 9 dips).
# Expected from the module's README and code and from stock's manual; not yet run on the unit.
# The MICRO TIMING screens are checked against their references. The BD track needs a sound that rings
# with the AMP envelope open.
# Changes the tempo, the BD track's AMP page and its ENV RESET in the active kit, and the BD track of the
# active pattern, which it clears; ends at 120 BPM, ENV RESET OFF, HLD 0, the track empty.
name: improved-amp-prefade-micro
state: changes
transport: any
target: unit

hold TRK
key BD
release TRK
# Tempo to 120.0: down to the bottom (30.0), then 90 BPM up, a step of the tempo screen's LEVEL being 1 BPM.
key TEMPO
enc LEVEL -127 x64
nudge LEVEL +21 per 6 x4
nudge LEVEL +6 per 6
wait 500
screen tempo
expect tempo == ref region 40 15 88 33
key NO
key AMP
cc 78 0
cc 79 57
cc 80 55
cc 81 0
cc 82 0
cc 83 0
cc 10 64
cc 7 100
hold FUNC
wait 300
key MUTE
release FUNC
key UP x4
key DOWN x4
key YES
key UP x8
key DOWN x2
key LEFT x3
key RIGHT
wait 500
screen er1
expect er1 == ref region 39 26 82 11
key NO x3
key RECORD
wait 300
key T1
key FUNC+PLAY
wait 800
key T1
key T3
key T5
key T7
wait 300
hold T3
wait 400
key RIGHT x6
wait 400
screen late
release T3
wait 300
hold T5
wait 400
key LEFT x6
wait 400
screen early
release T5
wait 300
expect late == ref region 0 13 128 40
expect early == ref region 0 13 128 40
expect early != late region 0 13 128 40
key RECORD
wait 300
audio mt BD 1900
wait 100
key PLAY
wait 780
key STOP
wait 900
wait 300
audio mt3 BD 5600
wait 100
key PLAY
wait 4830
key STOP
wait 900
hold FUNC
wait 300
key MUTE
release FUNC
key UP x4
key DOWN x4
key YES
key UP x8
key DOWN x2
key LEFT x3
wait 500
screen er0
expect er0 == ref region 39 26 82 11
key NO x3
key RECORD
wait 300
key T1
key FUNC+PLAY
wait 800
key RECORD
cc 79 0

expect mt.hits == 1
expect mt.dips == 3
expect mt.gapmin == 198 within 4
expect mt.gapmax == 276 within 4
expect mt3.hits == 3
expect mt3.dips == 9
